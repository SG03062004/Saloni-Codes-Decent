{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fooddelivery.internal/schemas/order-delivered.schema.json",
  "title": "OrderDelivered",
  "description": "Published by delivery-service when the driver confirms delivery. Consumed by order-service and notification-service.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "eventType": { "const": "order-delivered" },
        "payload": {
          "type": "object",
          "required": ["orderId", "driverId", "deliveredAt"],
          "additionalProperties": false,
          "properties": {
            "orderId": {
              "type": "string",
              "format": "uuid"
            },
            "driverId": {
              "type": "string",
              "format": "uuid"
            },
            "deliveredAt": {
              "type": "string",
              "format": "date-time",
              "description": "UTC timestamp when the driver confirmed delivery."
            }
          }
        }
      }
    }
  ]
}
