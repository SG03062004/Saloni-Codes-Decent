{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fooddelivery.internal/schemas/order-created.schema.json",
  "title": "OrderCreated",
  "description": "Published by order-service when a customer places an order. Consumed by restaurant-service, assignment-service, and notification-service.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "eventType": { "const": "order-created" },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "customerId",
            "restaurantId",
            "items",
            "deliveryAddress",
            "totalCents",
            "timestamp"
          ],
          "additionalProperties": false,
          "properties": {
            "orderId": {
              "type": "string",
              "format": "uuid"
            },
            "customerId": {
              "type": "string",
              "format": "uuid"
            },
            "restaurantId": {
              "type": "string",
              "format": "uuid"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["menuItemId", "quantity", "unitPriceCents"],
                "additionalProperties": false,
                "properties": {
                  "menuItemId": { "type": "string", "format": "uuid" },
                  "quantity":   { "type": "integer", "minimum": 1 },
                  "unitPriceCents": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "deliveryAddress": {
              "type": "object",
              "required": ["lat", "lng", "street", "city"],
              "additionalProperties": false,
              "properties": {
                "lat":    { "type": "number", "minimum": -90,  "maximum": 90  },
                "lng":    { "type": "number", "minimum": -180, "maximum": 180 },
                "street": { "type": "string" },
                "city":   { "type": "string" }
              }
            },
            "totalCents": {
              "type": "integer",
              "minimum": 0,
              "description": "Sum of (quantity * unitPriceCents) for all items."
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "When the order was placed by the customer."
            }
          }
        }
      }
    }
  ]
}
